{
  "plugin_id": "example.https-notification",
  "name": "外部通知集成",
  "version": "1.0.0",
  "description": "向管理员授权的公共 HTTPS 服务发送通知。example.com 是占位目标，安装前必须修改并审核。",
  "schema_version": 1,
  "runtime": "oboard-js-v1",
  "sdk_version": "oboard-sdk-v1",
  "entry": "main",
  "params_schema": {
    "type": "object",
    "properties": { "message": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "required": ["message"],
    "additionalProperties": false
  },
  "config_schema": { "type": "object", "additionalProperties": false },
  "env": [],
  "secrets": [{ "name": "notify_token", "purpose": "指定通知服务的 Bearer 令牌" }],
  "capabilities": ["network.request"],
  "resource_types": [],
  "network": { "allowed_origins": ["https://example.com"], "allowed_methods": ["POST"], "max_request_bytes": 4096, "max_response_bytes": 4096 },
  "limits": { "timeout_seconds": 15, "sdk_calls": 1, "manage_actions": 1 }
}
