FROM golang:1.25.11-alpine AS backend
WORKDIR /src
ARG VERSION=0.1.0-dev
ARG BUILD=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
ARG RELEASE_PUBLIC_KEY=
ARG AGENT_VERSION=0.1.0-dev
ARG AGENT_BUILD=dev
ARG AGENT_COMMIT=unknown
ARG AGENT_DATE=unknown
ARG KERNEL_VERSION=0.1.0-dev
ARG KERNEL_BUILD=dev
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X github.com/OboardProject/oboard/internal/version.Version=${VERSION} -X github.com/OboardProject/oboard/internal/version.Build=${BUILD} -X github.com/OboardProject/oboard/internal/version.Commit=${COMMIT} -X github.com/OboardProject/oboard/internal/version.Date=${BUILD_DATE} -X github.com/OboardProject/oboard/internal/version.ReleasePublicKey=${RELEASE_PUBLIC_KEY} -X github.com/OboardProject/oboard/internal/version.AgentVersion=${AGENT_VERSION} -X github.com/OboardProject/oboard/internal/version.AgentBuild=${AGENT_BUILD} -X github.com/OboardProject/oboard/internal/version.AgentCommit=${AGENT_COMMIT} -X github.com/OboardProject/oboard/internal/version.AgentDate=${AGENT_DATE} -X github.com/OboardProject/oboard/internal/version.KernelVersion=${KERNEL_VERSION} -X github.com/OboardProject/oboard/internal/version.KernelBuild=${KERNEL_BUILD}" \
    -o /out/oboard-controller ./cmd/controller

FROM node:22-alpine AS web
WORKDIR /src/web
COPY web/package*.json ./
RUN npm ci
COPY web ./
RUN npm run build

FROM alpine:3.22
ARG VERSION=0.1.0-dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="OBoard" \
      org.opencontainers.image.description="OBoard Controller" \
      org.opencontainers.image.source="https://github.com/OboardProject/oboard" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}"
RUN apk add --no-cache acme.sh ca-certificates curl openssl socat tzdata su-exec && adduser -D -H -u 1000 -s /sbin/nologin oboard
WORKDIR /app
COPY --from=backend /out/oboard-controller /usr/local/bin/oboard-controller
COPY --from=web /src/web/dist /app/web/dist
COPY dist/docker-downloads /app/downloads
COPY deploy/docker/entrypoint.sh /usr/local/bin/oboard-entrypoint
RUN chmod 0755 /usr/local/bin/oboard-entrypoint /usr/local/bin/oboard-controller \
    && mkdir -p /app/data /app/downloads \
    && chown -R oboard:oboard /app
EXPOSE 2787
ENV OBOARD_ADDR=:2787 \
    OBOARD_DB=/app/data/oboard.sqlite \
    OBOARD_LOG_FILE=/app/data/logs/controller.log \
    OBOARD_LOG_MAX_MB=32 \
    OBOARD_LOG_BACKUPS=5 \
    OBOARD_ACME_HOME=/app/data/acme \
    OBOARD_STATIC=/app/web/dist \
    OBOARD_DOWNLOADS=/app/downloads \
    OBOARD_AUTO_ADMIN=true
VOLUME ["/app/data"]
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 CMD wget -q -O /dev/null "http://127.0.0.1:2787${OBOARD_BASE_PATH}/healthz" || exit 1
ENTRYPOINT ["/usr/local/bin/oboard-entrypoint"]
CMD ["/usr/local/bin/oboard-controller"]
