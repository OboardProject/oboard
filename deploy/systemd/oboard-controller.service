[Unit]
Description=OBoard Controller
After=network-online.target oboard-controller-updater.service
Wants=network-online.target oboard-controller-updater.service

[Service]
Type=simple
Environment=OBOARD_ADDR=:2787
Environment=OBOARD_DB=/opt/oboard/data/oboard.sqlite
Environment=OBOARD_LOG_FILE=/opt/oboard/data/logs/controller.log
Environment=OBOARD_LOG_MAX_MB=32
Environment=OBOARD_LOG_BACKUPS=5
Environment=OBOARD_STATIC=/opt/oboard/web/dist
Environment=OBOARD_DOWNLOADS=/opt/oboard/downloads
EnvironmentFile=-/opt/oboard/config/controller.env
WorkingDirectory=/opt/oboard/data
ExecStart=/opt/oboard/oboard-controller
Restart=always
RestartSec=5
DynamicUser=false
User=oboard
Group=oboard
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/oboard
RuntimeDirectory=oboard/ai-worker
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
LockPersonality=true
MemoryDenyWriteExecute=true
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
