OBOARD_SESSION_SECRET=replace-with-at-least-32-random-bytes
OBOARD_ADDR=:2787
# Optional URL prefix for every panel, API, Agent, install, download, and health path.
# Use a hard-to-guess value such as /abc123; leave empty to serve from /.
OBOARD_BASE_PATH=
OBOARD_DB=/opt/oboard/data/oboard.sqlite
OBOARD_STATIC=/opt/oboard/web/dist
OBOARD_DOWNLOADS=/opt/oboard/downloads
OBOARD_GEOIP_DIR=/opt/oboard/downloads/geoip
OBOARD_BACKUP_DIR=/opt/oboard/data/backups
OBOARD_UPDATE_CHANNEL=stable
OBOARD_INSTALL_DIR=/opt/oboard
OBOARD_CONTROLLER_UPDATER_SOCKET=/run/oboard/controller-updater.sock
OBOARD_LOG_FILE=/opt/oboard/data/logs/controller.log
OBOARD_LOG_MAX_MB=32
OBOARD_LOG_BACKUPS=5
OBOARD_ACME_SH=/opt/oboard/tools/acme.sh
OBOARD_ACME_HOME=/opt/oboard/data/acme
OBOARD_AUTO_ADMIN=true
OBOARD_ADMIN_USERNAME=admin
# Optional: set this to choose the first admin password yourself.
# If empty, the installer generates a random password, prints it once when it finishes,
# and removes this line again after the controller has created the administrator.
# Change it from the panel immediately after first login.
# OBOARD_ADMIN_PASSWORD=

# Local reverse proxies on 127.0.0.1 or ::1 are trusted automatically.
# Set to true only when a trusted reverse proxy connects from another address and sets X-Forwarded-* headers.
# OBOARD_TRUST_PROXY=false
