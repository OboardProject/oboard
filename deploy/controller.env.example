OBOARD_SESSION_SECRET=replace-with-at-least-32-random-bytes
OBOARD_ADDR=:2787
# Optional URL prefix for every panel, API, Agent, install, download, and health path.
# Use a hard-to-guess value such as /abc123; leave empty to serve from /.
OBOARD_BASE_PATH=
OBOARD_DB=/var/lib/oboard/oboard.sqlite
OBOARD_STATIC=/opt/oboard/web/dist
OBOARD_DOWNLOADS=/opt/oboard/downloads
OBOARD_LOG_FILE=/var/lib/oboard/logs/controller.log
OBOARD_LOG_MAX_MB=32
OBOARD_LOG_BACKUPS=5
OBOARD_ACME_SH=acme.sh
OBOARD_ACME_HOME=/var/lib/oboard/acme
OBOARD_AUTO_ADMIN=true
OBOARD_ADMIN_USERNAME=admin
# Optional: set this to choose the first admin password yourself.
# If empty, the controller generates a random one-time password and prints it once at first boot.
# Change it from the panel immediately after first login.
# OBOARD_ADMIN_PASSWORD=

# Set to true only when Controller sits behind a trusted reverse proxy that sets X-Forwarded-* headers.
# OBOARD_TRUST_PROXY=false
