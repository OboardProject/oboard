#!/sbin/openrc-run

description="OBoard Controller Updater"
if [ -f /opt/oboard/config/controller.env ]; then
	set -a
	. /opt/oboard/config/controller.env
	set +a
fi
command="/opt/oboard/oboard-controller-updater"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/opt/oboard/data/logs/${RC_SVCNAME}.log"
error_log="/opt/oboard/data/logs/${RC_SVCNAME}.log"

depend() {
	need net
	after firewall
}

start_pre() {
	checkpath -d -m 0750 -o root:oboard /run/oboard
}
