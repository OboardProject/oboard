#!/sbin/openrc-run

description="OBoard Controller Updater"
command="/usr/local/bin/oboard-controller-updater"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

depend() {
	need net
	after firewall
	before docker
}

start_pre() {
	checkpath -d -m 0750 -o root:oboard /run/oboard
}
