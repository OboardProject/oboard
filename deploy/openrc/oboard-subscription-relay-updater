#!/sbin/openrc-run

description="OBoard subscription relay outbound updater"
command="/opt/oboard-subscription-relay/oboard-subscription-relay"
command_args="updater"
pidfile="/run/${RC_SVCNAME}.pid"
supervisor="supervise-daemon"
respawn_delay=10
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

if [ -r /opt/oboard-subscription-relay/relay.env ]; then
	. /opt/oboard-subscription-relay/relay.env
	export OBOARD_CONTROLLER_URL OBOARD_SUBSCRIPTION_RELAY_ID OBOARD_SUBSCRIPTION_RELAY_TOKEN OBOARD_SUBSCRIPTION_RELAY_SECRET
fi

depend() {
	need net oboard-subscription-relay
	after firewall
}

start_pre() {
	checkpath -f -m 0600 -o root "/var/log/${RC_SVCNAME}.log"
}
