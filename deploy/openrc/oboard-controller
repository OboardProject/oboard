#!/sbin/openrc-run

description="OBoard Controller"
if [ -f /opt/oboard/config/controller.env ]; then
	set -a
	. /opt/oboard/config/controller.env
	set +a
fi
command="/opt/oboard/oboard-controller"
command_user="oboard:oboard"
pidfile="/run/${RC_SVCNAME}.pid"
supervisor="supervise-daemon"
respawn_delay=5
output_log="/opt/oboard/data/logs/${RC_SVCNAME}.log"
error_log="/opt/oboard/data/logs/${RC_SVCNAME}.log"

depend() {
	need net oboard-controller-updater
	after firewall
}

start_pre() {
	checkpath -d -m 0750 -o oboard:oboard /opt/oboard/data /opt/oboard/data/logs /opt/oboard/web /opt/oboard/downloads /run/oboard/ai-worker
	if [ -f /opt/oboard/config/controller.env ]; then
		set -a
		. /opt/oboard/config/controller.env
		set +a
	fi
	: ${OBOARD_ADDR:=:2787}
	: ${OBOARD_BASE_PATH:=}
	: ${OBOARD_DB:=/opt/oboard/data/oboard.sqlite}
	: ${OBOARD_LOG_FILE:=/opt/oboard/data/logs/controller.log}
	: ${OBOARD_LOG_MAX_MB:=32}
	: ${OBOARD_LOG_BACKUPS:=5}
	: ${OBOARD_STATIC:=/opt/oboard/web/dist}
	: ${OBOARD_DOWNLOADS:=/opt/oboard/downloads}
	export OBOARD_ADDR OBOARD_BASE_PATH OBOARD_DB OBOARD_STATIC OBOARD_DOWNLOADS OBOARD_SESSION_SECRET OBOARD_LOG_FILE OBOARD_LOG_MAX_MB OBOARD_LOG_BACKUPS OBOARD_AI_WORKER_SOCKET OBOARD_TRUSTED_PROXY_CIDRS
}
