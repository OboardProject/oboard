{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oboard.invalid/schemas/plugins/manifest.json",
  "title": "OBoard installation manifest (oboard-js-v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["plugin_id", "name", "version", "description", "schema_version", "runtime", "sdk_version", "entry", "capabilities"],
  "properties": {
    "plugin_id": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
    "version": { "type": "string", "maxLength": 128, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
    "schema_version": { "const": 1 },
    "runtime": { "const": "oboard-js-v1" },
    "sdk_version": { "const": "oboard-sdk-v1" },
    "entry": { "const": "main" },
    "params_schema": { "$ref": "#/$defs/parameterSchema" },
    "config_schema": { "$ref": "#/$defs/parameterSchema" },
    "output_schema": { "$ref": "#/$defs/parameterSchema" },
    "env": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": {
      "name": { "type": "string", "minLength": 1, "pattern": "^[^\\s=]+$" },
      "default": { "type": "string" }, "overridable": { "type": "boolean", "default": false }, "sensitive": { "type": "boolean", "default": false }
    } } },
    "secrets": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "purpose"], "properties": { "name": { "type": "string", "minLength": 1 }, "purpose": { "type": "string" } } } },
    "capabilities": { "type": "array", "minItems": 1, "items": { "enum": [
      "servers.get", "servers.list", "servers.status", "metrics.latest", "incidents.get", "services.status", "services.restart", "host.poweroff", "host.reboot", "notifications.send", "operations.get", "operations.wait", "state.get", "state.compareAndSet", "config.get", "network.request", "management.query", "management.preview", "management.apply",
      "management:inventory.read", "management:servers.list", "management:servers.get", "management:servers.metrics.read", "management:servers.latency_probes.read", "management:servers.connectivity.read", "management:servers.connectivity.sla", "management:servers.connectivity.events", "management:servers.dns_policy.get", "management:deployments.plan", "management:deployments.apply", "management:servers.update", "management:inbounds.create", "management:inbounds.update", "management:inbounds.delete", "management:proxy_paths.create", "management:proxy_paths.update", "management:proxy_paths.delete"
    ] } },
    "resource_types": { "type": "array", "items": { "type": "string" } },
    "limits": { "type": "object", "additionalProperties": false, "properties": {
      "timeout_seconds": { "type": "integer", "minimum": 0, "maximum": 300 },
      "memory_mib": { "type": "integer", "minimum": 0, "maximum": 64 },
      "sdk_calls": { "type": "integer", "minimum": 0, "maximum": 100 },
      "manage_actions": { "type": "integer", "minimum": 0, "maximum": 10 },
      "log_bytes": { "type": "integer" }, "result_bytes": { "type": "integer" }
    } },
    "network": { "type": "object", "additionalProperties": false, "required": ["allowed_origins", "allowed_methods"], "properties": {
      "allowed_origins": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "pattern": "^https://[^/?#@]+$" } },
      "allowed_methods": { "type": "array", "minItems": 1, "maxItems": 7, "items": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"] } },
      "max_request_bytes": { "type": "integer", "minimum": 0, "maximum": 65536 },
      "max_response_bytes": { "type": "integer", "minimum": 0, "maximum": 262144 }
    } }
  },
  "allOf": [
    {
      "if": { "properties": { "capabilities": { "contains": { "const": "network.request" } } } },
      "then": { "required": ["network"] },
      "else": { "not": { "required": ["network"] } }
    }
  ],
  "$defs": {
    "parameterSchema": { "type": ["object", "boolean", "null"], "description": "Host additionally rejects every $ref and enforces UTF-8 byte, depth and node limits. This schema does not fetch references inside plugin schemas." }
  }
}
