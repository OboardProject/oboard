{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oboard.dev/schemas/plugin-manifest.json",
  "title": "OBoard plugin manifest",
  "description": "manifest.json of an OBoard plugin (runtime oboard-js). The Controller applies the same rules plus cross-field checks; unknown fields are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "description",
    "runtime",
    "entry",
    "capabilities",
    "triggers",
    "limits"
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
      "not": {
        "pattern": "^oboard\\."
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "runtime": {
      "const": "oboard-js"
    },
    "entry": {
      "const": "main.js"
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "servers.read",
          "servers.health.read",
          "servers.metrics.read",
          "network.ping",
          "network.trace",
          "network.tcp_probe",
          "network.dns_lookup",
          "network.http_probe",
          "http.request",
          "state.read",
          "state.write",
          "secrets.use",
          "notifications.send",
          "users.read",
          "users.notify",
          "plans.read",
          "plans.notify",
          "events.server_status",
          "ui.page"
        ]
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hosts",
        "methods"
      ],
      "description": "Required with http.request. Hosts are exact names or a single leading *. wildcard; never IPs.",
      "properties": {
        "hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "GET",
              "HEAD",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "servers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 1
            },
            "reason": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      }
    },
    "environment": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "label"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
            "not": {
              "pattern": "^OBOARD_"
            }
          },
          "type": {
            "enum": [
              "string",
              "text",
              "integer",
              "number",
              "boolean",
              "select",
              "multi_select",
              "server",
              "servers",
              "secret",
              "url",
              "duration",
              "json"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "required": {
            "type": "boolean"
          },
          "default": {
            "description": "Normalized by type. Not allowed for secret, server and servers."
          },
          "placeholder": {
            "type": "string",
            "maxLength": 200
          },
          "min_length": {
            "type": "integer",
            "minimum": 0
          },
          "max_length": {
            "type": "integer",
            "minimum": 1
          },
          "pattern": {
            "type": "string",
            "maxLength": 200
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "min_duration": {
            "type": "string",
            "pattern": "^([0-9]+h)?([0-9]+m)?([0-9]+s)?$",
            "minLength": 2,
            "description": "Whole seconds, for example 30s, 5m or 1h30m"
          },
          "max_duration": {
            "type": "string",
            "pattern": "^([0-9]+h)?([0-9]+m)?([0-9]+s)?$",
            "minLength": 2,
            "description": "Whole seconds, for example 30s, 5m or 1h30m"
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "value"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "min_items": {
            "type": "integer",
            "minimum": 0
          },
          "max_items": {
            "type": "integer",
            "minimum": 1
          },
          "filter": {
            "type": "array",
            "items": {
              "enum": [
                "enrolled",
                "online",
                "ipv4",
                "ipv6"
              ]
            },
            "uniqueItems": true
          },
          "schemes": {
            "type": "array",
            "items": {
              "enum": [
                "https",
                "http"
              ]
            },
            "uniqueItems": true
          },
          "depends_on": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "equals"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "equals": {}
            }
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "maxItems": 8,
      "description": "Required with ui.page. Each page is a closed view rendered on the plugin instance page.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "maxLength": 32, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "actions": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "type": "string", "maxLength": 32, "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }
          }
        }
      }
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schedule"
      ],
      "properties": {
        "schedule": {
          "type": "boolean"
        },
        "events": {
          "type": "array",
          "items": {
            "enum": [
              "server.online",
              "server.offline"
            ]
          },
          "uniqueItems": true,
          "description": "Requires events.server_status."
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": {
          "type": "string",
          "pattern": "^([0-9]+h)?([0-9]+m)?([0-9]+s)?$",
          "minLength": 2,
          "description": "1s to 2m, for example 30s"
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 16,
          "maximum": 128
        },
        "sdk_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "http_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "agent_operations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "log_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        }
      }
    }
  }
}
