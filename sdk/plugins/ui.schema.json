{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oboard.invalid/schemas/plugins/ui.json",
  "title": "OBoard declarative plugin UI",
  "type": "object", "additionalProperties": false, "required": ["pages"],
  "properties": { "pages": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/page" } } },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
    "page": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "components"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/label" }, "description": { "type": "string", "maxLength": 2048 },
        "components": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/component" } }
      }
    },
    "action": {
      "type": "object", "additionalProperties": false, "required": ["label"],
      "properties": { "label": { "$ref": "#/$defs/label" }, "params": { "type": "object", "maxProperties": 32, "propertyNames": { "$ref": "#/$defs/id" } } }
    },
    "column": {
      "type": "object", "additionalProperties": false, "required": ["key", "label"],
      "properties": { "key": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/label" } }
    },
    "field": {
      "type": "object", "additionalProperties": false, "required": ["name", "label", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/label" }, "type": { "enum": ["text", "number", "boolean", "select"] },
        "required": { "type": "boolean" }, "options": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/label" } }
      },
      "allOf": [{ "if": { "properties": { "type": { "const": "select" } } }, "then": { "required": ["options"], "properties": { "options": { "minItems": 1 } } }, "else": { "properties": { "options": { "maxItems": 0 } } } }]
    },
    "component": {
      "type": "object", "additionalProperties": false, "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["text", "stat", "table", "form", "button"] },
        "title": { "type": "string", "maxLength": 128 }, "text": { "type": "string", "maxLength": 8192 },
        "columns": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/column" } },
        "fields": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/field" } },
        "action": { "$ref": "#/$defs/action" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["text", "stat"] } } }, "then": { "not": { "required": ["action"] }, "properties": { "fields": { "maxItems": 0 }, "columns": { "maxItems": 0 } } } },
        { "if": { "properties": { "type": { "const": "table" } } }, "then": { "required": ["columns"], "properties": { "columns": { "minItems": 1 }, "fields": { "maxItems": 0 } } } },
        { "if": { "properties": { "type": { "const": "form" } } }, "then": { "required": ["action"], "properties": { "columns": { "maxItems": 0 } } } },
        { "if": { "properties": { "type": { "const": "button" } } }, "then": { "required": ["action"], "properties": { "columns": { "maxItems": 0 }, "fields": { "maxItems": 0 } } } }
      ]
    }
  }
}
